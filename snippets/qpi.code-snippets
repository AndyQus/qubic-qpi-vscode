{
  "QPI Public Procedure": {
    "prefix": "qpi-procedure",
    "scope": "qpi,cpp",
    "body": [
      "PUBLIC_PROCEDURE(${1:ProcedureName})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "QPI PUBLIC_PROCEDURE block — no local variables"
  },
  "QPI Public Function": {
    "prefix": "qpi-function",
    "scope": "qpi,cpp",
    "body": [
      "PUBLIC_FUNCTION(${1:FunctionName})",
      "{",
      "\t$0",
      "\treturn ${2:output};",
      "}"
    ],
    "description": "QPI PUBLIC_FUNCTION block — no local variables, must return a value"
  },
  "QPI Public Procedure With Locals": {
    "prefix": "qpi-procedure-locals",
    "scope": "qpi,cpp",
    "body": [
      "PUBLIC_PROCEDURE_WITH_LOCALS(${1:ProcedureName})",
      "{",
      "\t// Local variable declarations",
      "\t${2:sint64} ${3:localVar};",
      "",
      "\t$0",
      "}"
    ],
    "description": "QPI PUBLIC_PROCEDURE_WITH_LOCALS — allows local variable declarations"
  },
  "QPI Public Function With Locals": {
    "prefix": "qpi-function-locals",
    "scope": "qpi,cpp",
    "body": [
      "PUBLIC_FUNCTION_WITH_LOCALS(${1:FunctionName})",
      "{",
      "\t// Local variable declarations",
      "\t${2:sint64} ${3:localVar};",
      "",
      "\t$0",
      "\treturn ${4:output};",
      "}"
    ],
    "description": "QPI PUBLIC_FUNCTION_WITH_LOCALS — allows local variables, must return a value"
  },
  "QPI Contract Skeleton": {
    "prefix": "qpi-contract",
    "scope": "qpi,cpp",
    "body": [
      "// Qubic Smart Contract — ${1:ContractName}",
      "// Generated by Qubic QPI Extension",
      "",
      "struct ${1:ContractName} : public ContractBase",
      "{",
      "\t// -------------------------------------------------------------------------",
      "\t// State variables",
      "\t// -------------------------------------------------------------------------",
      "\tuint64 ${2:stateVariable};",
      "",
      "\t// -------------------------------------------------------------------------",
      "\t// Input / Output structs",
      "\t// -------------------------------------------------------------------------",
      "\tstruct ${3:MyInput}_input",
      "\t{",
      "\t\tuint64 ${4:amount};",
      "\t};",
      "",
      "\tstruct ${3:MyInput}_output",
      "\t{",
      "\t\tuint64 ${5:result};",
      "\t};",
      "",
      "\t// -------------------------------------------------------------------------",
      "\t// Epoch hooks",
      "\t// -------------------------------------------------------------------------",
      "\tBEGIN_EPOCH",
      "\t{",
      "\t\t$0",
      "\t}",
      "\tEND_EPOCH",
      "",
      "\t// -------------------------------------------------------------------------",
      "\t// Tick hooks",
      "\t// -------------------------------------------------------------------------",
      "\tBEGIN_TICK",
      "\t{",
      "\t}",
      "\tEND_TICK",
      "",
      "\t// -------------------------------------------------------------------------",
      "\t// Public procedures and functions",
      "\t// -------------------------------------------------------------------------",
      "\tPUBLIC_PROCEDURE(${3:MyInput})",
      "\t{",
      "\t}",
      "",
      "\t// -------------------------------------------------------------------------",
      "\t// Registration",
      "\t// -------------------------------------------------------------------------",
      "\tREGISTER_USER_FUNCTIONS_AND_PROCEDURES",
      "\t{",
      "\t\tREGISTER_USER_PROCEDURE(${3:MyInput}, 1);",
      "\t}",
      "};",
      ""
    ],
    "description": "Full Qubic Smart Contract skeleton with state, I/O structs, epoch/tick hooks, and registration"
  },
  "QPI Epoch Block": {
    "prefix": "qpi-epoch",
    "scope": "qpi,cpp",
    "body": [
      "BEGIN_EPOCH",
      "{",
      "\t$0",
      "}",
      "END_EPOCH"
    ],
    "description": "QPI BEGIN_EPOCH / END_EPOCH block — runs once per epoch"
  },
  "QPI Tick Block": {
    "prefix": "qpi-tick",
    "scope": "qpi,cpp",
    "body": [
      "BEGIN_TICK",
      "{",
      "\t$0",
      "}",
      "END_TICK"
    ],
    "description": "QPI BEGIN_TICK / END_TICK block — runs once per tick"
  },
  "QPI Contract Doc Comment": {
    "prefix": "qpi-contract-doc",
    "scope": "qpi,cpp",
    "body": [
      "/**",
      " * @contract ${1:ContractName}",
      " * @description ${2:Brief description of what this contract does}",
      " * @author ${3:YourName}",
      " * @version ${4:1}",
      " * @procedure ${5:ProcedureName} — ${6:What this procedure does}",
      " * @function ${7:FunctionName} — ${8:What this function returns}",
      " * @state ${9:stateName} — ${10:What this state variable tracks}",
      " */"
    ],
    "description": "JSDoc-style contract metadata block for AI coding agents and documentation"
  },
  "QPI Private Procedure": {
    "prefix": "qpi-private-procedure",
    "body": [
      "PRIVATE_PROCEDURE(${1:Name})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Declares a procedure callable only from inside this contract."
  },
  "QPI Private Function": {
    "prefix": "qpi-private-function",
    "body": [
      "PRIVATE_FUNCTION(${1:Name})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Declares a read-only function callable only from inside this contract."
  },
  "QPI Entry Point Input/Output Structs": {
    "prefix": "qpi-io-structs",
    "body": [
      "struct ${1:name}_input",
      "{",
      "\t${2:uint64 value;}",
      "};",
      "",
      "struct ${1:name}_output",
      "{",
      "\t${3:sint64 result;}",
      "};",
      "$0"
    ],
    "description": "Input/output struct pair for a public procedure or function. Only integer/bool types, id, Array, BitArray and structs of those are allowed here (QPI018)."
  },
  "QPI Initialize Block": {
    "prefix": "qpi-initialize",
    "body": [
      "INITIALIZE()",
      "{",
      "\t$0",
      "}"
    ],
    "description": "System procedure run once when the contract is constructed."
  }
}
